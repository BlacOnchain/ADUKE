rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isStaff() {
      return isSignedIn() && (
        getUserData().role in ['owner', 'manager', 'chef', 'cashier', 'waiter']
      );
    }

    function isManagerOrOwner() {
      return isSignedIn() && (
        getUserData().role in ['owner', 'manager']
      );
    }

    // Menu: Publicly readable; editable by manager or owner or head chef
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isManagerOrOwner() || hasRole('chef');
    }

    // Orders: Readable and creatable by guests and staff; status updates by staff
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isManagerOrOwner();
    }

    // Reservations: Guests can book; staff can manage seating
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isManagerOrOwner();
    }

    // Table Live Sessions (QR sessions, waiter buzzers, bills)
    match /table_sessions/{tableId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isManagerOrOwner();
    }

    // Customer Reviews: Public read; create permitted
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isManagerOrOwner();
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isManagerOrOwner());
    }
  }
}
